{
  "name": "upload-post-action",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "test": "vitest run",
    "extract-params": "node scripts/extract-params.mjs",
    "probe-sdk": "node scripts/probe-sdk.mjs",
    "check-sdk-map": "node scripts/probe-sdk.mjs --check",
    "all": "npm test && npm run build"
  },
  "keywords": [
    "github-action",
    "social-media",
