    "@actions/core": "^3.0.1",
    "upload-post": "2.14.1"
  },
  "type": "module",
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "vitest": "^5.0.2"
  },
  "private": true,
  "homepage": "https://www.upload-post.com",
  "engines": {
    "node": ">=20"
